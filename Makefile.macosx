# The intent of this Makefile
# is to build and install `lua-uuid`
# through LuaRocks on macOS / iOS,
# using variables defined by LuaRocks.
# For a feature-complete Makefile,
# take a look at `Makefile.unix`.

MAKEFILE_COMMON_FLAGS = -f Makefile.unix "OBJEXT=.$(OBJ_EXTENSION)" "LIBEXT=.$(LIB_EXTENSION)"

.PHONY: all
all: lib

.PHONY: lib
lib:
	$(MAKE) $(MAKEFILE_COMMON_FLAGS) "CCDEFINES=" "SOFLAGS=$(LIBFLAG)" "LIBS=$(LIBFLAG_EXTRA)" lib

.PHONY: install
install:
	$(MAKE) $(MAKEFILE_COMMON_FLAGS) "INSTALL_CMOD=$(INSTALL_LIBDIR)" install

.PHONY: clean
clean:
	$(MAKE) $(MAKEFILE_COMMON_FLAGS) clean

.PHONY: test
test:
	$(MAKE) $(MAKEFILE_COMMON_FLAGS) test
